# ── Публичный адрес сайта ───────────────────────────────────
# Используется в canonical, og:url, sitemap.xml и robots.txt.
# Локально можно поставить http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://romapp.ru

# ── Только для docker-compose.prod.yml ───────────────────────
# Домен без протокола и без www
DOMAIN=romapp.ru

# Почта для Let's Encrypt: туда придёт письмо, если сертификат не продлится
CERTBOT_EMAIL=vvvvc636@gmail.com

# ── Только для docker-compose.yml (прод без HTTPS) ───────────
HTTP_PORT=80
